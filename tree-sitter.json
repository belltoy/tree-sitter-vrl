{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vrl",
      "camelcase": "Vrl",
      "scope": "source.vrl",
      "path": ".",
      "file-types": ["vrl"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "VRL grammar for tree-sitter",
    "authors": [
      { "name": "Zhongqiu Zhao", "email": "belltoy@gmail.com" }
    ],
    "links": {
      "repository": "https://github.com/belltoy/tree-sitter-vrl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
